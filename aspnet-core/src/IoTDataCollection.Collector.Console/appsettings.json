{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mqtt": {
    "Server": "localhost",
    "Port": 1883,
    "ClientId": "iot_collector_001",
    "Username": "",
    "Password": "",
    "KeepAliveSeconds": 60,
    "ReconnectDelaySeconds": 5
  },
  "Storage": {
    "DatabasePath": "data/collector.db",
    "RetentionDays": 30,
    "MaxDatabaseSizeMB": 1000
  },
  "Http": {
    "BaseUrl": "https://localhost:44330",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryIntervalSeconds": 5
  },
  "Collector": {
    "CollectorNodeCode": "COLLECTOR_001",
    "SamplingIntervalSeconds": 5,
    "HeartbeatIntervalSeconds": 30,
    "DataSendIntervalSeconds": 10,
    "ConfigSyncIntervalSeconds": 300,
    "MaxRetryCount": 3,
    "RetryIntervalSeconds": 5,
    "EnableRuleEngine": true,
    "EnableLocalStorage": true,
    "EnableMqttCommunication": true,
    "EnableConfigSync": true
  }
}