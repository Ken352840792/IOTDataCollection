<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>IoTDataCollection.Collector.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IoTDataCollection.Collector.Core\IoTDataCollection.Collector.Core.csproj" />
    <ProjectReference Include="..\IoTDataCollection.Collector.Protocols\IoTDataCollection.Collector.Protocols.csproj" />
    <ProjectReference Include="..\IoTDataCollection.Collector.Rules\IoTDataCollection.Collector.Rules.csproj" />
    <ProjectReference Include="..\IoTDataCollection.Collector.Storage\IoTDataCollection.Collector.Storage.csproj" />
    <ProjectReference Include="..\IoTDataCollection.Collector.Communication\IoTDataCollection.Collector.Communication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project> 