        "info": "验证Node-RED安装和MySQL连接"
    },
    {
        "id": "test_inject",
        "type": "inject",
        "z": "verification_tab",
        "name": "点击测试",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "测试开始",
        "payloadType": "str",
        "x": 150,
        "y": 120,
        "wires": [
            ["test_mysql"]
        ]
    },
    {
        "id": "test_mysql",
        "type": "function",
        "z": "verification_tab", 
        "name": "准备SQL查询",
        "func": "// 测试数据库连接的简单查询\nmsg.topic = \"SELECT 'Node-RED连接MySQL成功!' as message, NOW() as current_time\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 120,
        "wires": [
            ["mysql_query"]
        ]
    },
    {
        "id": "mysql_query",
        "type": "mysql",
        "z": "verification_tab",
        "mydb": "iot_mysql_config",
        "name": "执行MySQL查询",
        "x": 570,
        "y": 120,
        "wires": [
            ["format_result"]
        ]
    },
    {
        "id": "format_result",
        "type": "function",
        "z": "verification_tab",
        "name": "格式化结果",
        "func": "if (msg.payload && msg.payload.length > 0) {\n    const result = msg.payload[0];\n    msg.payload = {\n        status: \"✅ 成功\",\n        message: result.message,\n        timestamp: result.current_time,\n        connection: \"Node-RED ↔ MySQL 连接正常\"\n    };\n} else {\n    msg.payload = {\n        status: \"❌ 失败\",\n        message: \"无法获取数据库响应\"\n    };\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 120,
        "wires": [
            ["debug_output"]
        ]
    },
    {
        "id": "debug_output",
        "type": "debug",
        "z": "verification_tab",
        "name": "验证结果",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 930,
        "y": 120,
        "wires": []
    },
