    },
    {
        "id": "query_enterprises",
        "type": "function",
        "z": "verification_tab",
        "name": "查询企业表",
        "func": "// 查询IoT业务表验证数据\nmsg.topic = \"SELECT F_ENTERPRISE_CODE, F_ENTERPRISE_NAME, F_STATUS FROM T_ENTERPRISES LIMIT 3\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 200,
        "wires": [
            ["mysql_query_2"]
        ]
    },
    {
        "id": "mysql_query_2",
        "type": "mysql",
        "z": "verification_tab",
        "mydb": "iot_mysql_config",
        "name": "查询IoT数据",
        "x": 570,
        "y": 200,
        "wires": [
            ["format_iot_result"]
        ]
    },
    {
        "id": "format_iot_result",
        "type": "function",
        "z": "verification_tab",
        "name": "IoT数据结果",
        "func": "if (msg.payload && msg.payload.length > 0) {\n    msg.payload = {\n        status: \"✅ IoT表连接成功\",\n        count: msg.payload.length,\n        data: msg.payload,\n        message: \"Node-RED可以正常访问IoT业务数据\"\n    };\n} else {\n    msg.payload = {\n        status: \"⚠️ 无IoT数据\",\n        message: \"数据库连接正常，但T_ENTERPRISES表为空\"\n    };\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 200,
        "wires": [
            ["debug_iot"]
        ]
